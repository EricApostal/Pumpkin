/// How placing a custom block chooses its property values, like vanilla's `getStateForPlacement`.
///
/// Without rules a placed block gets its default state (plus its `connect-rules`). A rule sets one
/// property from the placement, by value name: the property has to list the name its source gives.
/// Rules are tried in order and the first one that gives a value for a property wins, so several
/// rules for one property form a fallback. Connect rules apply afterwards. Rules only apply when a
/// player places the block.
///
/// Rules can be set until the server starts accepting connections (after plugin load and
/// `server-load-event`) and need the `registry.blocks` permission. Setting the same rules again is
/// fine, other rules for a block that has some fail.
interface block-placement {
    /// How the property of a neighbour says where its shaft points, see `shaft-neighbour`.
    enum shaft-kind {
        /// The property lists a direction (`facing`): the shaft points into the placed block when
        /// the value is the opposite of the direction from the neighbour to the placed block.
        facing,
        /// The property lists an axis (`axis`): the shaft points into the placed block when the
        /// direction from the neighbour to the placed block runs along that axis.
        axis,
    }

    /// A neighbour that has a shaft pointing into the placed block, like Create's
    /// `IRotate.hasShaftTowards`. Only the blocks a plugin registered are read, from their
    /// registration properties; a vanilla neighbour never has a shaft.
    record shaft-neighbour {
        /// Blocks that count, by tag (`create:shafts`).
        tag: string,
        /// The property that says where the shaft points (`axis`, `facing`).
        property: string,
        kind: shaft-kind,
    }

    /// Where a rule takes the value of its property from. The property must list the value names
    /// given for each source.
    variant placement-source {
        /// The horizontal direction the player looks at: `north`, `south`, `east`, `west`.
        horizontal-facing,
        /// The dominant direction the player looks at: `down`, `up`, `north`, `south`, `west`,
        /// `east`.
        looking-direction,
        /// The face of the clicked block (clicking a top face gives `up`): `down`, `up`, `north`,
        /// `south`, `west`, `east`.
        clicked-face,
        /// The face of the clicked block, except that `up` gives `down`, for hopper-like facing
        /// properties that have no `up`: `down`, `north`, `south`, `west`, `east`.
        clicked-face-down,
        /// The axis of the clicked face: `x`, `y`, `z`. `opposite` is not allowed.
        clicked-axis,
        /// The horizontal axis of the direction the player looks at: `x` or `z`. `opposite` is not
        /// allowed. For blocks whose axis is horizontal only, like Create's pulleys.
        horizontal-axis,
        /// `bottom` or `top` like vanilla's stairs and slabs: clicking the top face or the lower
        /// half of a side gives `bottom`.
        clicked-half,
        /// `up` or `down` when the pitch is at least this many degrees (above 0, at most 90) up or
        /// down, otherwise `horizontal`. A property without `horizontal` is left to the next rule.
        vertical-look(f32),
        /// `true` when the block replaces a water source (waterlogged), `false` otherwise.
        in-water,
        /// `true` when the player sneaks, `false` otherwise.
        sneaking,
        /// The direction of the neighbour that has a shaft pointing into the placed block: `down`,
        /// `up`, `north`, `south`, `west`, `east`. None when no neighbour has one, or when two
        /// neighbours on different axes both have one (the give-up of
        /// `DirectionalKineticBlock.getPreferredFacing`). For a bearing, `opposite` makes the
        /// bearing face away from the shaft.
        neighbour-shaft(list<shaft-neighbour>),
        /// Always this value, useful as the last rule of a fallback.
        constant(string),
    }

    /// Sets `property` when the block is placed.
    record placement-rule {
        property: string,
        source: placement-source,
        /// Use the opposite of the source's value (`north` for `south`, `top` for `bottom`, `false`
        /// for `true`). Not allowed for `clicked-axis` and `constant`.
        opposite: bool,
        /// Only apply the rule when the player sneaks (`true`) or does not sneak (`false`). A rule
        /// that does not apply leaves the property to the next rule. None always applies.
        when-sneaking: option<bool>,
    }

    /// Sets the placement rules of a block registered with `register-block`, at most 64. Fails for
    /// an unknown block or property, a value the property does not list, `opposite` where it is not
    /// allowed, a pitch out of range, an empty tag or property in a `neighbour-shaft`, other rules
    /// than before, or when registration is closed.
    set-block-placement-rules: func(block-key: string, rules: list<placement-rule>) -> result<_, string>;
}
