package pumpkin:plugin@0.2.0;

interface enchantments {
  use text.{text-component};

  /// Equipment slot where an enchantment is active.
  enum attribute-modifier-slot {
    any,
    main-hand,
    off-hand,
    hand,
    feet,
    legs,
    chest,
    head,
    armor,
    body,
    saddle,
  }

  /// Vanilla enchantments enum.
  enum enchantment {
    aqua-affinity,
    bane-of-arthropods,
    binding-curse,
    blast-protection,
    breach,
    channeling,
    density,
    depth-strider,
    efficiency,
    feather-falling,
    fire-aspect,
    fire-protection,
    flame,
    fortune,
    frost-walker,
    impaling,
    infinity,
    knockback,
    looting,
    loyalty,
    luck-of-the-sea,
    lunge,
    lure,
    mending,
    multishot,
    piercing,
    power,
    projectile-protection,
    protection,
    punch,
    quick-charge,
    respiration,
    riptide,
    sharpness,
    silk-touch,
    smite,
    soul-speed,
    sweeping-edge,
    swift-sneak,
    thorns,
    unbreaking,
    vanishing-curse,
    wind-burst,
  }

  /// Represents a custom enchantment definition.
  record custom-enchantment {
    /// Unique identifier for the enchantment (e.g. "my_plugin:lifesteal").
    id: string,
    /// Description or display name of the enchantment.
    description: text-component,
    /// Maximum level of the enchantment (e.g. 1..=10).
    max-level: u32,
    /// Base anvil repair/combination cost multiplier.
    anvil-cost: u32,
    /// Tag or item pattern for supported items (e.g. "#minecraft:enchantable/weapon").
    supported-items: string,
    /// Weight / rarity of the enchantment (higher = more common, default 5).
    weight: u32,
    /// Equipment slots where this enchantment is active.
    slots: list<attribute-modifier-slot>,
    /// List of exclusive/conflicting enchantment IDs.
    exclusive-set: list<string>,
  }

  /// An effect component of an enchantment, as in the `effects` of its registry data.
  record enchantment-effect {
    /// The effect component type, for example `minecraft:ammo_use` or one registered with
    /// `register-enchantment-effect-type`.
    component-key: string,
    /// The component value as network NBT (the root tag type and its payload, no name).
    value-nbt-bytes: list<u8>,
  }

  /// Global manager for registering and querying custom enchantments.
  resource enchantment-manager {
    /// Registers a new custom enchantment with the server.
    register-enchantment: async func(enchantment: custom-enchantment) -> result<_, string>;

    /// Sets the effect components of a registered enchantment. They are part of the
    /// `minecraft:enchantment` registry data sent to every client. Replaces earlier effects.
    set-enchantment-effects: async func(id: string, effects: list<enchantment-effect>) -> result<_, string>;

    /// Sets the enchanting costs of a registered enchantment (`base + per-level * (level - 1)`).
    /// Without it the minimum is 1 + 10 per level and the maximum 21 + 10 per level.
    set-enchantment-costs: async func(id: string, min-base: s32, min-per-level: s32, max-base: s32, max-per-level: s32) -> result<_, string>;

    /// Registers an enchantment effect component type and returns its id, after the vanilla
    /// ones. NeoForge clients get it in `minecraft:enchantment_effect_component_type`.
    register-enchantment-effect-type: async func(key: string) -> result<u32, string>;

    /// Gets an enchantment definition by its ID.
    get-enchantment: async func(id: string) -> option<custom-enchantment>;

    /// Checks if an enchantment ID is registered.
    has-enchantment: async func(id: string) -> bool;

    /// Returns all registered custom enchantment IDs.
    get-all-enchantment-ids: async func() -> list<string>;
  }
}
